pkgbase = sumi-shell-git
	pkgdesc = Hyprland desktop shell built with Quickshell
	pkgver = 0.4.0.r88.g1feaa2d
	pkgrel = 1
	url = https://github.com/kitasael-burakku/Sumi-Shell
	install = sumi-shell.install
	arch = any
	license = MIT
	makedepends = git
	depends = quickshell>=0.3.1
	depends = qt6-declarative
	depends = qt6-wayland
	depends = hyprland
	depends = python>=3.11
	depends = systemd
	depends = bash
	depends = coreutils
	depends = findutils
	depends = procps-ng
	depends = util-linux
	depends = sed
	depends = grep
	depends = dbus
	depends = fontconfig
	depends = pipewire
	depends = wireplumber
	depends = ttf-iosevkaterm-nerd
	optdepends = qt6-multimedia: wallpaper video previews
	optdepends = lua: luac for Lua integration (must match the compositor Lua version)
	optdepends = binutils: readelf for automatic Lua integration
	optdepends = hypridle: idle locking and suspend coordination
	optdepends = hyprlock: fallback when the shell cannot hold the lock
	optdepends = networkmanager: network controls
	optdepends = libnm: NetworkManager helper
	optdepends = python-gobject: NetworkManager helper
	optdepends = bluez: Bluetooth
	optdepends = upower: battery status
	optdepends = power-profiles-daemon: power profiles
	optdepends = matugen: dynamic palettes
	optdepends = hyprpaper: image wallpapers
	optdepends = awww: animated image wallpapers
	optdepends = mpvpaper: video wallpapers
	optdepends = imagemagick: thumbnails
	optdepends = ffmpeg: video thumbnails
	optdepends = cliphist: clipboard history
	optdepends = wl-clipboard: clipboard copy and paste
	optdepends = calcurse: calendar
	optdepends = ddcutil: external monitor brightness
	optdepends = curl: downloads and online services
	optdepends = grim: screenshots
	optdepends = pciutils: graphics hardware information
	optdepends = xdg-utils: opening files and URLs
	optdepends = pacman-contrib: package update checks
	optdepends = fakeroot: required by checkupdates
	optdepends = jq: helper JSON queries
	optdepends = python-dbus: inhibitors and power through login1 without systemd
	optdepends = wf-recorder: screen recording
	optdepends = slurp: region selection for recording
	optdepends = libpulse: pactl for recording audio and profile tests
	optdepends = playerctl: audio profile tests
	optdepends = libnotify: optional desktop notifications from helpers
	optdepends = libsecret: secret-tool for CalDAV credentials (requires Secret Service)
	optdepends = cava: live audio spectrum
	optdepends = gsettings-desktop-schemas: optional GTK theme synchronisation
	optdepends = xsettingsd: optional X11 theme transport
	optdepends = python-fonttools: advanced font metrics
	optdepends = python-cbor2: Qt 5 platform plugin diagnostics
	optdepends = sumi-sddm: optional login screen management (separate project)
	provides = sumi-shell
	conflicts = sumi-shell
	options = !strip
	options = !debug
	source = sumi-shell::git+https://github.com/kitasael-burakku/Sumi-Shell.git
	source = package.py
	source = ARCH.md
	sha256sums = SKIP
	sha256sums = e3b1b5c46ab9b695a57ea900735518df52c2eb8f5ecc9f77db15be8d8fcb9b8c
	sha256sums = ac64f3b369aa0c7f5d2b935f504ab89976bad6909c9370c23d98348dd8924b39

pkgname = sumi-shell-git
